{
  "name": "fengsha-mod-manager",
  "private": false,
  "version": "0.3.3",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-site.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:release": "node scripts/build-desktop.mjs && npm run build",
    "desktop:installer": "node scripts/build-desktop.mjs && node scripts/build-installer.mjs",
    "publish:update": "node scripts/publish-update.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "lucide-vue-next": "^0.474.0",
    "sharp": "^0.35.5",
    "vite": "^6.0.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2"
  }
}
